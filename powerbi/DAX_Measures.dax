// ==============================================================================
// Hotel Booking Cancellation & Revenue Recovery: Power BI DAX Library
// Author: Naman Gupta (Data Analyst Portfolio)
// Metrics: Hospitality Revenue Management, Cancellation Hazards & Overbooking
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. VOLUME & OCCUPANCY MEASURES
// ------------------------------------------------------------------------------

Total Reservations = 
COUNTROWS(hotel_bookings)

Confirmed Bookings = 
CALCULATE(
    COUNTROWS(hotel_bookings),
    hotel_bookings[is_canceled] = 0
)

Canceled Bookings = 
CALCULATE(
    COUNTROWS(hotel_bookings),
    hotel_bookings[is_canceled] = 1
)

Cancellation Rate % = 
DIVIDE(
    [Canceled Bookings],
    [Total Reservations],
    0
)

Total Room Nights Stayed = 
CALCULATE(
    SUMX(hotel_bookings, hotel_bookings[stays_in_weekend_nights] + hotel_bookings[stays_in_week_nights]),
    hotel_bookings[is_canceled] = 0
)

Total Room Nights Lost = 
CALCULATE(
    SUMX(hotel_bookings, hotel_bookings[stays_in_weekend_nights] + hotel_bookings[stays_in_week_nights]),
    hotel_bookings[is_canceled] = 1
)

// ------------------------------------------------------------------------------
// 2. FINANCIAL & REVENUE MEASURES
// ------------------------------------------------------------------------------

Average Daily Rate (ADR) = 
AVERAGE(hotel_bookings[adr])

Realized Room Revenue = 
CALCULATE(
    SUMX(
        hotel_bookings,
        (hotel_bookings[stays_in_weekend_nights] + hotel_bookings[stays_in_week_nights]) * hotel_bookings[adr]
    ),
    hotel_bookings[is_canceled] = 0
)

Lost Revenue from Cancellations = 
CALCULATE(
    SUMX(
        hotel_bookings,
        (hotel_bookings[stays_in_weekend_nights] + hotel_bookings[stays_in_week_nights]) * hotel_bookings[adr]
    ),
    hotel_bookings[is_canceled] = 1
)

Total Potential Revenue = 
[Realized Room Revenue] + [Lost Revenue from Cancellations]

Revenue Realization Efficiency % = 
DIVIDE(
    [Realized Room Revenue],
    [Total Potential Revenue],
    0
)

// ------------------------------------------------------------------------------
// 3. LEAD TIME & CHANNEL RISK MEASURES
// ------------------------------------------------------------------------------

Average Lead Time (Days) = 
AVERAGE(hotel_bookings[lead_time])

Online TA Cancellation Rate % = 
CALCULATE(
    [Cancellation Rate %],
    hotel_bookings[market_segment] = "Online TA"
)

Direct Booking Cancellation Rate % = 
CALCULATE(
    [Cancellation Rate %],
    hotel_bookings[market_segment] = "Direct"
)

Repeated Guest Loyalty Rate % = 
DIVIDE(
    CALCULATE(COUNTROWS(hotel_bookings), hotel_bookings[is_repeated_guest] = 1),
    [Total Reservations],
    0
)
